{
  "name": "kotor-stories-protected-demo",
  "version": "1.1.0-dev",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check": "tsc --noEmit",
    "test:gps": "tsc src/gpsEngine.ts src/geo.ts --target ES2022 --module commonjs --strict --skipLibCheck --outDir .test-build && node --test tests/gpsEngine.test.cjs",
    "audio:serve": "node scripts/serve_protected_packs.mjs",
    "audio:test": "node --test tests/protectedServer.test.mjs",
    "audio:test:qwen": "node --test tests/qwenServer.test.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.10",
    "expo-crypto": "~58.0.0",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.12",
    "expo-location": "~58.0.18",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
